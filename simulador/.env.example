# Copia este archivo como .env antes de levantar el simulador.
LOG_LEVEL=INFO

# --- Dónde están los sistemas ---
# Con el simulador en Docker usa host.docker.internal; si lo corres con Python
# directamente en tu equipo, cambia ambos por http://localhost:8001 y :8002.
TARGET_A_URL=http://host.docker.internal:8001
TARGET_B_URL=http://host.docker.internal:8002
# Lo que abre tu navegador al pulsar "Abrir tienda"
TARGET_A_PUBLIC_URL=http://localhost:8001
TARGET_B_PUBLIC_URL=http://localhost:8002

# --- Escenario "Caída de un nodo" ---
# docker = apaga/enciende el contenedor indicado (nombres por defecto de docker compose)
FAILOVER_A_MODE=docker
FAILOVER_A_CONTAINER=compraya-sistema-a-postgres-1
FAILOVER_B_MODE=docker
FAILOVER_B_CONTAINER=compraya-sistema-b-shard1-a-1
# Alternativa sin Docker: FAILOVER_A_MODE=shell y los comandos que quieras, por ejemplo
# FAILOVER_A_KILL_CMD=docker compose -f ../sistema-a-actual/docker-compose.yml kill postgres
# FAILOVER_A_RESTORE_CMD=docker compose -f ../sistema-a-actual/docker-compose.yml start postgres

# --- Límites de seguridad ---
MAX_VIRTUAL_USERS=600
MAX_DURATION_S=300
REQUEST_TIMEOUT_S=15
