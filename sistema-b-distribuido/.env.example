# Copia este archivo como .env antes de levantar el sistema.
LOG_LEVEL=INFO
# Workers por réplica (hay 3 réplicas detrás de nginx)
API_WORKERS=1

MONGO_DB=compraya
MONGO_MAX_POOL_SIZE=50

# TTLs de Redis (segundos)
PRODUCT_CACHE_TTL_S=300
LIST_CACHE_TTL_S=30
CART_TTL_S=604800
IDEMPOTENCY_TTL_S=86400

# Pasarela de pago simulada (igual en ambos sistemas)
PAYMENT_LATENCY_MS=80
PAYMENT_FAILURE_RATE=0.02

# --- ETL desde el Sistema A (python -m scripts.etl_from_postgres) ---
# Dentro de Docker, el PostgreSQL del Sistema A se alcanza por el host: host.docker.internal
ETL_SOURCE_DSN=postgresql://compraya:compraya@host.docker.internal:5432/compraya
ETL_BATCH_SIZE=1000
ETL_TRUNCATE_TARGET=false
